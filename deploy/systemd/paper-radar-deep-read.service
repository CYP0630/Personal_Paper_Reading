[Unit]
Description=Personal Paper Radar daily Top-8 deep reading
Documentation=https://github.com/CYP0630/Personal_Paper_Reading
Wants=network-online.target
After=network-online.target paper-radar.service

[Service]
Type=oneshot
WorkingDirectory=%h/Personal_Paper_Reading
EnvironmentFile=-%h/.config/paper-radar/env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/Personal_Paper_Reading/src
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m paper_radar deep-read --input-root %h/.local/share/paper-radar --output-root %h/.local/share/paper-radar --workdir %h/Personal_Paper_Reading/reading_workspace --publish
TimeoutStartSec=8h
